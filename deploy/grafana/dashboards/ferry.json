      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (to) (rate(ferry_payout_transitions_total[5m])) * 60",
          "legendFormat": "to {{to}}",
          "refId": "A"
