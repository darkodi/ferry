          "expr": "histogram_quantile(0.5, sum by (le) (rate(ferry_payout_transition_age_seconds_bucket{to=\"settled\"}[30m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ferry_payout_transition_age_seconds_bucket{to=\"settled\"}[30m])))",
