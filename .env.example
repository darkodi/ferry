# Copy to .env (git-ignored) and adjust. Never commit real secrets.

# Local Postgres (docker compose)
POSTGRES_USER=ferry
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ferry
POSTGRES_PORT=5432
DATABASE_URL=postgres://ferry:change-me@localhost:5432/ferry?sslmode=disable

# API server (cmd/api)
# Operator key for admin routes. Generate one with: openssl rand -hex 32
FERRY_ADMIN_KEY=
# "dev" enables /v1/dev/deposits, makes the mock rail settle at once, and runs the
# relay, worker and resolver inside the API process (the mock rail cannot be shared).
FERRY_ENV=dev
FERRY_ADDR=127.0.0.1:8080
# Encrypts customers' saved bank details (AES-256-GCM). Required by cmd/api, never by the
# worker. Generate with: openssl rand -base64 32   (KMS in M7). Losing it makes saved
# destinations unreadable; changing it needs re-encryption.
FERRY_DATA_KEY=

# Observability. Each binary serves Prometheus metrics on its own loopback port (defaults:
# api 9101, relay 9102, worker 9103, watchers 9104/9105); set FERRY_METRICS_ADDR=off to disable.
# Traces are exported over OTLP/HTTP only when the endpoint is set (Jaeger from `make obs-up`).
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=change-me

# Payout queue (cmd/relay, cmd/worker). Locally this is ElasticMQ from docker compose;
# on AWS leave FERRY_SQS_ENDPOINT empty and use the real queue URL and IAM credentials.
ELASTICMQ_PORT=9324
FERRY_SQS_ENDPOINT=http://localhost:9324
FERRY_SQS_QUEUE_URL=http://localhost:9324/000000000000/ferry-payouts
# The dead-letter queue, read by cmd/worker for the ferry_queue_messages gauge (DLQ alert).
FERRY_SQS_DLQ_URL=http://localhost:9324/000000000000/ferry-payouts-dlq
AWS_REGION=us-east-1
# ElasticMQ ignores credentials, but the AWS SDK requires some. Placeholders only.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Local EVM chain (Anvil, docker compose) and deposit addresses.
ANVIL_PORT=8545
FERRY_EVM_CHAIN=evm-local
FERRY_EVM_RPC_URL=http://localhost:8545
# Printed by `make chain-setup`; the first deploy on a fresh Anvil always lands here.
FERRY_EVM_USDC_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
FERRY_EVM_CONFIRMATIONS=2
FERRY_EVM_START_BLOCK=1
# Account xpub (m/44'/60'/1') of the PUBLIC test mnemonic "test test ... junk".
# Dev only: anyone can derive its private keys. On testnet use your own xpub;
# the matching private key never goes into Ferry's config.
FERRY_EVM_XPUB=xpub6Ce9NcJvTk372KjsGfWqbcex5DumjpNquQLApoeQUavSCjEc823BV1tb4rXUuPuht8h2hSxkg2EXUaKUJmniJvRZAELxypsCzBFdtosmV76

# Local Solana (solana-test-validator, docker compose) and deposit accounts.
SOLANA_RPC_PORT=8899
FERRY_SOLANA_CHAIN=solana-local
FERRY_SOLANA_RPC_URL=http://localhost:8899
# The three keys below are printed by `make chain-setup`; they stay the same across chain
# resets because the keypairs are kept in .dev/solana (git-ignored).
FERRY_SOLANA_USDC_MINT=
# Public key that deposit accounts derive from. The API needs only this.
FERRY_SOLANA_AUTHORITY=
# The authority's keypair file, read only by the Solana watcher (it pays for and signs
# deposit account creation, nothing else). Dev key from `make chain-setup`; on devnet keep
# it outside the repo (KMS in M7).
FERRY_SOLANA_AUTHORITY_KEYPAIR=.dev/solana/authority.json
# Public key that owns the deposit token accounts: only its private key can move deposited
# USDC, and Ferry never gets it (it belongs to the future sweep, KMS in M7).
FERRY_SOLANA_DEPOSIT_OWNER=
# First slot to scan on a fresh database; empty starts at the current finalized slot.
FERRY_SOLANA_START_SLOT=

# Payout rail: "mock" (default; in-memory, dev only) or "noah". cmd/api quotes with it;
# cmd/worker submits with it (the mock cannot serve a separate worker).
FERRY_RAIL=mock
# How long a payout may sit held or submitted before the resolver re-drives it. Without a
# public webhook URL this is how often Noah is polled for status.
FERRY_RESOLVER_STALE=1m

# Noah Business API. Sandbox by default; for a local run without a sandbox key, start the
# fake with `make fake-noah` and set NOAH_BASE_URL=http://127.0.0.1:18090/v1, NOAH_API_KEY=fake-noah-key.
NOAH_BASE_URL=https://api.sandbox.noah.com/v1
NOAH_CRYPTO_CURRENCY=USDC_TEST
# Ferry's own quote lifetime (Noah's prepare returns no expiry).
NOAH_QUOTE_TTL=2m
NOAH_API_KEY=
# ES384 (P-384) private key that signs requests (Api-Signature). Optional in sandbox for a key
# created without a signing public key; required in production. Keep it outside the repo:
#   openssl ecparam -name secp384r1 -genkey -noout -out ~/.config/ferry/noah-signing.pem
NOAH_SIGNING_KEY_PATH=
# Webhooks are verified with Noah's published key for the base URL's environment. Set a PEM
# public key file here only for the fake (or a key rotation Noah announces).
NOAH_WEBHOOK_PUBLIC_KEY=
