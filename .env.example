# Copy to .env (git-ignored) and adjust. Never commit real secrets.

# Local Postgres (docker compose)
POSTGRES_USER=ferry
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ferry
POSTGRES_PORT=5432
DATABASE_URL=postgres://ferry:change-me@localhost:5432/ferry?sslmode=disable

# API server (cmd/api)
# Operator key for admin routes. Generate one with: openssl rand -hex 32
FERRY_ADMIN_KEY=
# "dev" enables /v1/dev/deposits and makes the mock rail settle at once.
FERRY_ENV=dev
FERRY_ADDR=127.0.0.1:8080

# Noah sandbox rail (M5)
NOAH_BASE_URL=https://api.sandbox.noah.com/v1
NOAH_API_KEY=
# Path to the ES384 private key used to sign outbound requests. Keep the key outside the repo.
NOAH_SIGNING_KEY_PATH=
